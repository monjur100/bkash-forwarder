<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#effcf6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#A7F3D0"
            android:gravity="center"
            android:padding="18dp"
            android:text="বিকাশ SMS ফরোয়ার্ডার"
            android:textColor="#064e3b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#12271f"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="সার্ভারের ঠিকানা (API URL)"
            android:textColor="#5b7268"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ffffff"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#12271f"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="সিক্রেট কী (BKSG_SECRET)"
            android:textColor="#5b7268"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ffffff"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#12271f"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#6ee7b7"
            android:text="সেভ করুন"
            android:textColor="#064e3b" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#A7F3D0"
            android:text="সার্ভারের সাথে সংযোগ পরীক্ষা"
            android:textColor="#064e3b" />

        <Button
            android:id="@+id/btnPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#A7F3D0"
            android:text="SMS পারমিশন দিন"
            android:textColor="#064e3b" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#A7F3D0"
            android:text="ব্যাটারি সেটিংস খুলুন (Unrestricted করুন)"
            android:textColor="#064e3b" />
    </LinearLayout>
</ScrollView>
